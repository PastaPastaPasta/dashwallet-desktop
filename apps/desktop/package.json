{
  "name": "dashwallet-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Dash Wallet on Tauri 2 + React",
  "scripts": {
    "dev": "vite",
    "build": "pnpm tokens:check && tsc --noEmit && vite build && node scripts/check-bundle.mjs dist --production",
    "build:fixture": "pnpm tokens:check && tsc --noEmit && vite build --mode fixture && node scripts/check-bundle.mjs dist-fixture --fixture",
    "preview": "vite preview --port 1420 --strictPort",
    "preview:fixture": "vite preview --mode fixture --port 1420 --strictPort",
    "tokens": "node scripts/gen-tokens.mjs",
    "tokens:check": "node scripts/gen-tokens.mjs --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "pnpm build:fixture && playwright test",
    "e2e:tauri": "bash scripts/e2e-tauri.sh",
    "e2e:tauri:onboarding": "bash scripts/e2e-tauri-onboarding.sh",
    "e2e:tauri:tools": "bash scripts/e2e-tauri-tools.sh",
    "e2e:tauri:settings": "bash scripts/e2e-tauri-settings.sh",
    "tauri": "node scripts/tauri.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@tanstack/react-query": "5.104.1",
    "@tauri-apps/api": "2.12.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "@tauri-apps/cli": "2.12.1",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  },
  "packageManager": "pnpm@12.9.1"
}
