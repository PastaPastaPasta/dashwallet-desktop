{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "What the main window may call: the gate commands and event listening. Nothing else (no shell, fs, http or opener plugin is installed).",
  "windows": ["main"],
  "local": true,
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-launch-info",
    "allow-open-network",
    "allow-list-wallets",
    "allow-lock-status",
    "allow-unlock",
    "allow-lock",
    "allow-balance",
    "allow-sync-status",
    "allow-history-page",
    "allow-tx-detail",
    "allow-startup-mark",
    "allow-selftest-report",
    "allow-selftest-checkpoint",
    "allow-ipc-bench-rows",
    "allow-history-page-timed"
  ]
}
