    "allow-platform-receive-address",
    "allow-platform-send-quote",
    "allow-platform-send",
    "allow-platform-fund-quote",
    "allow-platform-fund",
    "allow-pending-platform-funds",
    "allow-resume-platform-fund",
    "allow-shielded-status",
