{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "identity",
  "description": "DashPay identities, registration, names, credits, invitations and leases. Granted to the main window only; `probe_unlisted` is never granted (U6).",
  "windows": [
    "main"
  ],
  "local": true,
  "permissions": [
    "allow-discover-identities",
    "allow-identities",
    "allow-quorum-source",
    "allow-trusted-quorums-only",
    "allow-set-trusted-quorums-only",
    "allow-identity-detail",
    "allow-identity-refresh-balance",
    "allow-set-main-identity",
    "allow-registration-quote",
    "allow-start-registration",
    "allow-start-registration-past-unknown-funding",
    "allow-registrations",
    "allow-resume-registration",
    "allow-discard-registration",
    "allow-finish-asset-locks",
    "allow-prepare-faucet-lock",
    "allow-check-username",
    "allow-name-availability",
    "allow-register-name",
    "allow-set-main-name",
    "allow-main-name",
    "allow-contest-status",
    "allow-search-users",
    "allow-resolve-user",
    "allow-credits-cost-table",
    "allow-credits-top-up-quote",
    "allow-credits-top-up",
    "allow-credits-pending-top-ups",
    "allow-credits-stuck-top-up-fundings",
    "allow-credits-resume-top-up",
    "allow-credits-resolve-top-up",
    "allow-credits-withdraw-quote",
    "allow-credits-withdraw",
    "allow-credits-withdrawals",
    "allow-grant-request",
    "allow-dispatch-status",
    "allow-resolve-stuck-funding",
    "allow-begin-flow",
    "allow-end-flow",
    "allow-leases",
    "allow-stash-invitation",
    "allow-invitation-status",
    "allow-pending-invitations",
    "allow-forget-invitation",
    "allow-dashpay-status",
    "allow-dashpay-sync-now",
    "allow-dashpay-sync-status"
  ]
}
