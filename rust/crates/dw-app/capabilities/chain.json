{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "chain",
  "description": "Chain, sync and tools. Granted to the main window only; `probe_unlisted` is never granted (U6).",
  "windows": [
    "main"
  ],
  "local": true,
  "permissions": [
    "allow-sync-status",
    "allow-peers",
    "allow-rotate-peers",
    "allow-rescan",
    "allow-rescan-progress",
    "allow-cancel-rescan",
    "allow-node-info",
    "allow-warnings",
    "allow-reset-chain-data",
    "allow-set-birth-height",
    "allow-start-spv",
    "allow-stop-spv",
    "allow-spv-running",
    "allow-spv-state",
    "allow-dashpay-startup",
    "allow-dashpay-sync-soon",
    "allow-platform-loops",
    "allow-set-platform-cadence",
    "allow-platform-status"
  ]
}
