{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "coinjoin",
  "description": "CoinJoin mixing. Granted to the main window only; `probe_unlisted` is never granted (U6).",
  "windows": [
    "main"
  ],
  "local": true,
  "permissions": [
    "allow-coinjoin-limits",
    "allow-coinjoin-settings",
    "allow-set-coinjoin-settings",
    "allow-coinjoin-status",
    "allow-start-mixing",
    "allow-stop-mixing",
    "allow-coinjoin-salt",
    "allow-set-coinjoin-salt",
    "allow-generate-coinjoin-salt",
    "allow-coinjoin-recovery-scan",
    "allow-mixed-coins-sweep-plan",
    "allow-move-mixed-coins"
  ]
}
