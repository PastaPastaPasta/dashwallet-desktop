{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "masternodes",
  "description": "My masternodes: the masternode list's state, the wallet's masternodes and their payouts, tracking and attached keys, evonode credits, the masternode keychain with its reveal (MG-10 S1), the owner's registrar update with its operations, resend and discard (MG-10 S3), and shared-masternode sessions up to approval (MG-10b S5), with signing and sending the registration (MG-10 S5b). Granted to the main window only.",
  "windows": [
    "main"
  ],
  "local": true,
  "permissions": [
    "allow-mn-list-state",
    "allow-mn-list",
    "allow-mn-masternode",
    "allow-mn-payouts",
    "allow-mn-find",
    "allow-mn-evonode-credits",
    "allow-mn-track",
    "allow-mn-untrack",
    "allow-mn-set-label",
    "allow-mn-attach-key",
    "allow-mn-detach-key",
    "allow-mn-keys",
    "allow-mn-reveal-key",
    "allow-mn-preview-update-registrar",
    "allow-mn-update-registrar",
    "allow-mn-operations",
    "allow-mn-resend-operation",
    "allow-mn-discard-operation",
    "allow-mn-shared-capability",
    "allow-mn-shared-sessions",
    "allow-mn-shared-unreadable",
    "allow-mn-shared-abandon",
    "allow-mn-shared-abandon-unreadable",
    "allow-mn-shared-session",
    "allow-mn-shared-start",
    "allow-mn-shared-set-fee",
    "allow-mn-shared-join",
    "allow-mn-shared-message",
    "allow-mn-shared-lock",
    "allow-mn-shared-unlock",
    "allow-mn-shared-approve",
    "allow-mn-shared-sign",
    "allow-mn-shared-send",
    "allow-mn-shared-discard",
    "allow-mn-shared-import",
    "allow-mn-shared-import-file",
    "allow-mn-registration-keys",
    "allow-mn-preview-registration",
    "allow-mn-register",
    "allow-mn-prepare-external-registration",
    "allow-mn-refresh-external-registration",
    "allow-mn-submit-external-registration",
    "allow-mn-release-collateral",
    "allow-mn-lock-collateral"
  ]
}
