{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DashPay Desktop",
  "mainBinaryName": "dash-wallet",
  "version": "1.0.0",
  "identifier": "org.dash.wallet.desktop",
  "build": {
    "frontendDist": "../../../apps/desktop/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DashPay Desktop",
        "width": 1280,
        "height": 820,
        "minWidth": 920,
        "minHeight": 600,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self'",
        "img-src": "'self' data:",
        "font-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      },
      "freezePrototype": true,
      "capabilities": [
        "app",
        "network",
        "vault",
        "wallets",
        "chain",
        "history",
        "backup",
        "send",
        "coinjoin",
        "identity",
        "social",
        "connect",
        "console",
        "units",
        "shell",
        "files",
        "scan",
        "governance",
        "masternodes",
        "rates",
        "updates"
      ]
    },
    "withGlobalTauri": false
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVEMzIyQjk2M0I1MjdCMjEKUldRaGUxSTdsaXN5N1ZTQ3hDYjdsNjh4RG16TTIwa3JJT0Q2TDZsTnlid0VKQVp1elg0YUZFRlMK",
      "endpoints": [],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "dash",
          "pay",
          "dashwallet",
          "dashpay"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage",
      "nsis",
      "dmg"
    ],
    "category": "Finance",
    "publisher": "DashPay Desktop contributors",
    "homepage": "https://github.com/PastaPastaPasta/dashwallet-desktop",
    "shortDescription": "DashPay Desktop",
    "longDescription": "The Dash wallet with DashPay, on the desktop.",
    "copyright": "Copyright (c) DashPay Desktop contributors. MIT license.",
    "license": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "linux": {
      "deb": {
        "depends": [],
        "desktopTemplate": "linux/dash-wallet.desktop"
      },
      "rpm": {
        "desktopTemplate": "linux/dash-wallet.desktop"
      }
    }
  }
}
