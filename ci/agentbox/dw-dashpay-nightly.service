# Install (every step is required; do not enable the timer before step 5 has delivered its message):
#  1. Install the launcher and the notifier outside DW_DP_STATE and outside any checkout:
#     `install -d -m 700 ~/.local/libexec/dashwallet-desktop` and
#     `install -m 700 regtest/scripts/dashpay-nightly.sh regtest/scripts/dashpay-nightly-notify.sh
#     ~/.local/libexec/dashwallet-desktop/`.
#  2. Copy this unit, dw-dashpay-nightly-failed.service and dw-dashpay-nightly.timer to
#     ~/.config/systemd/user/.
#  3. Write the environment file below (mode 0600).
#  4. `systemctl --user daemon-reload`.
#  5. Verify the notifier with one test start: `systemctl --user start
#     dw-dashpay-nightly-failed.service`, and check that its message arrived where the site's
#     notifier delivers it.
#  6. `systemctl --user enable --now dw-dashpay-nightly.timer`.
#
# The environment file sets DW_DP_STATE, DW_DP_FUNDER, DW_DP_FUNDER_BIRTH, DW_DP_HOLD_UPSTREAM
# and DW_DP_NOTIFY. DW_DP_STATE is an absolute directory outside any checkout, owned by this
# user with mode 0700 (the launcher and the harness create it so, and refuse one open to group or
# others, a symlink, or one that is or sits in a git checkout). DW_DP_FUNDER names the funder's
# phrase file, owner-only (0600 or 0400; the harness refuses any other mode): on agentbox the
# secret store's link, never a file in this repository. The funder is a dedicated testnet wallet
# with a small capped balance: the build runs as this same user. DW_DP_NOTIFY is the absolute
# path of a site-provided executable that delivers its one argument (a message, chat or mail);
# the launcher refuses to run without it.
#
# Not gating, alerting: a failed run fails this unit, and OnFailure= starts
# dw-dashpay-nightly-failed.service, which runs DW_DP_NOTIFY with the unit's result and exit
# status and the run's artifact directory ($DW_DP_STATE/nightly/<date>: junit.xml, pytest.log,
# nightly.log, the dwcli logs), never test output.
#
# The unit runs on testnet only: the launcher refuses any other DW_DP_NET (one set in the
# environment file included). LimitCORE=0 (and the harness's own core limit) keeps a crash from
# dumping a process that holds the run's secrets.
#
# The unit uses the system's default temporary directory; to use another, set TMPDIR in the
# environment file to an existing directory this user can write.
[Unit]
Description=dashwallet-desktop DashPay suites on testnet, nightly (DASHPAY §6 T3)
OnFailure=dw-dashpay-nightly-failed.service

[Service]
Type=oneshot
EnvironmentFile=%h/.config/dashwallet-desktop/dashpay-nightly.env
UMask=0077
LimitCORE=0
Environment=DW_DP_NET=testnet
ExecStart=%h/.local/libexec/dashwallet-desktop/dashpay-nightly.sh
Nice=10
TimeoutStartSec=4h
